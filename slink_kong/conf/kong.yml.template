_format_version: "1.1"
services:
  - name: user-service

    url: http://user-service:8000
    routes:
      - name: user-v1
        paths:
          - /api/v1/users/me/
          - /api/v1/users/set_username/
          - /api/v1/users/set_password/
        methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false

      - name: cities-v1
        paths:
          - /api/v1/countries/
          - /api/v1/cities/
        methods: ["GET", "OPTIONS"]
        preserve_host: true
        strip_path: false


      - name: friendship-v1
        paths:
          - /api/v1/friendship/
        methods: ["POST", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false


      - name: check-username-v1
        paths:
          - /api/v1/check-username/
        methods: ["GET", "OPTIONS"]
        preserve_host: true
        strip_path: false

    plugins:
      - name: jwt
        config:
          header_names:
            - Authorization
          secret_is_base64: false
          claims_to_verify:
            - exp

  - name: user-service-non-jwt
    url: http://user-service:8000
    routes:
      - name: users-v1
        paths:
          - /api/v1/users/
          - /api/v1/users/activation/
          - /api/v1/users/registration/
          - /api/v1/users/resend_activation/
          - /api/v1/users/reset_password/
          - /api/v1/users/password_reset_confirm/
        methods: [ "GET", "POST", "OPTIONS" ]
        preserve_host: true
        strip_path: false

      - name: cities-v1
        paths:
          - /api/v1/countries/
          - /api/v1/cities/
        methods: [ "GET", "OPTIONS" ]
        preserve_host: true
        strip_path: false

      - name: jwt-v1
        paths:
          - /api/v1/users/jwt/
        methods: [ "POST", "OPTIONS" ]
        preserve_host: true
        strip_path: false

      - name: admin
        paths:
          - /admin/
          - /__dubug__/
        methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false

      - name: static-files
        paths:
          - /static
        methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        strip_path: false

      - name: openapi
        paths:
          - /swagger/
          - /redoc/
        methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false

  - name: posts_service
    url: http://posts-service:8000
    routes:
      - name: posts-v1
        paths:
          - /api/v1/posts/
        methods: ["POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false

      - name: posts-archived-v1
        paths:
          - /api/v1/posts/archived/
        methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false

    plugins:
      - name: jwt
        config:
          header_names:
            - Authorization
          secret_is_base64: false
          claims_to_verify:
            - exp

  - name: posts_service_non_jwt
    url: http://posts-service:8000
    routes:
      - name: posts-v1-non-jwt
        paths:
          - /api/v1/posts/
        methods: ["GET", "OPTIONS"]
        preserve_host: true
        strip_path: false

      - name: openapi
        paths:
          - /posts-service/redoc
          - /posts-service/swagger
          - /posts-service/openapi.json
        methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        preserve_host: true
        strip_path: false

plugins:
  - name: cors
    config:
      origins:
        - ${CORS}
      methods:
        - GET
        - POST
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      headers:
        - Accept
        - Content-Type
        - Authorization
      exposed_headers:
        - Authorization
      credentials: true
      max_age: 3600
      preflight_continue: false

consumers:
  - username: "user-service"
    custom_id: "user-service"
    jwt_secrets:
      - algorithm: HS256
        key: "user_service"
        secret: ${JWT_SECRET}
